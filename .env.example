# MongoDB Atlas connection string (or any MongoDB URI)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fine_arts

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Admin login: leave username blank, enter this as the password
ADMIN_PASSWORD=choose-a-strong-admin-password

# Initial team passwords (only used the first time the database is created).
# Leave blank to set them later from the admin Teams page.
TEAM1_PASSWORD=
TEAM2_PASSWORD=
TEAM3_PASSWORD=
TEAM4_PASSWORD=

PORT=3000
